<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device-to-device transfer of app data.
     allowBackup="false" alone does not stop device-to-device migration. Moving to a new phone
     works via the app's own export (training data) and backup password (encrypted profile). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
